# ============================================================
# Salin file ini menjadi .env, lalu isi dengan nilai lokal.
#     Copy-Item backend\.env.example backend\.env
#
# File .env TIDAK boleh di-commit. File ini hanya berisi placeholder,
# jadi aman ikut masuk repo sebagai dokumentasi konfigurasi.
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=url_shortener_app
DB_PASSWORD=change_me
DB_NAME=url_shortener_db
DB_SSLMODE=disable

# --- Aplikasi ---
# Dipakai untuk menyusun short_url pada response POST /shorten.
# Tanpa trailing slash. Wajib diisi; server menolak start kalau kosong.
BASE_URL=http://localhost:8000

# Port HTTP server.
APP_PORT=8000

# Origin frontend yang diizinkan CORS.
ALLOWED_ORIGIN=http://localhost:5173
